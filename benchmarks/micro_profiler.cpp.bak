    // Helpers for Stroke Cap Matrix
    auto run_caps_nisaba = [&](LineCap cap) {
        Stroke s(14.0f);
        s.line_cap = cap;
        Paint p(Color::from_rgba8(20, 184, 166, 220));
        for (int i = 0; i < 20; ++i) {
            float y = 80.0f + i * 30.0f;
            canvas.stroke_line(100.0f, y, 980.0f, y, p, s);
        }
    };
    auto run_caps_cairo = [&](cairo_line_cap_t cap) {
        cairo_set_source_rgba(cr, 20/255.0, 184/255.0, 166/255.0, 220/255.0);
        cairo_set_line_width(cr, 14.0);
        cairo_set_line_cap(cr, cap);
        for (int i = 0; i < 20; ++i) {
            double y = 80.0 + i * 30.0;
            cairo_move_to(cr, 100.0, y);
            cairo_line_to(cr, 980.0, y);
        }
        cairo_stroke(cr);
    };

    // 40. Stroke Cap: Butt (20 Line Segments 14px)
    benchmark_op("40. Stroke Cap: Butt (20 Line Segments 14px)",
        [&]() { run_caps_nisaba(LineCap::Butt); },
        [&]() { run_caps_cairo(CAIRO_LINE_CAP_BUTT); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_stroke_style(BLRgba32(20, 184, 166, 220));
            b2d_ctx.set_stroke_width(14.0);
            b2d_ctx.set_stroke_caps(BL_STROKE_CAP_BUTT);
            for (int i = 0; i < 20; ++i) {
                b2d_ctx.stroke_line(BLLine(100.0, 80.0 + i * 30.0, 980.0, 80.0 + i * 30.0));
            }
#endif
        }
    );

    // 41. Stroke Cap: Square (20 Line Segments 14px)
    benchmark_op("41. Stroke Cap: Square (20 Line Segments 14px)",
        [&]() { run_caps_nisaba(LineCap::Square); },
