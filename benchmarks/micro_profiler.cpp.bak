            b2d_ctx.save();
            b2d_ctx.clip_to_rect(BLRect(0, 0, 1080, 740));
            b2d_ctx.set_fill_style(BLRgba32(15, 23, 42, 255));
            b2d_ctx.fill_all();
            BLLinearGradientValues g_val{0.0, 0.0, 1080.0, 740.0};
            BLGradient g(g_val);
            g.add_stop(0.0, BLRgba32(59, 130, 246, 200));
            g.add_stop(1.0, BLRgba32(236, 72, 153, 200));
            b2d_ctx.set_fill_style(g);
            b2d_ctx.fill_all();
            b2d_ctx.set_fill_style(BLRgba32(255, 255, 255, 80));
            for (int i = 0; i < 15; ++i) {
