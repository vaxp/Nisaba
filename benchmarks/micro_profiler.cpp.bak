    // 31. Image Bilinear Scaling (2x Scale Up 512x512)
    benchmark_op("31. Image Bilinear Scaling (2x Scale Up 512x512)",
        [&]() {
            canvas.save();
            canvas.translate(284.0f, 114.0f);
