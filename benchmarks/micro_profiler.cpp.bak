    // 32. Image Rotation & Affine Transform (35° Filtered)
    benchmark_op("32. Image Rotation & Affine Transform (35° Filtered)",
        [&]() {
            canvas.save();
            canvas.translate(540.0f, 370.0f);
            canvas.rotate(35.0f);
            canvas.translate(-128.0f, -128.0f);
            PixmapPaint pp;
            pp.quality = FilterQuality::Bilinear;
            canvas.draw_pixmap(0, 0, test_pm.as_ref(), pp);
            canvas.restore();
        },
        [&]() {
            cairo_save(cr);
            cairo_translate(cr, 540.0, 370.0);
            cairo_rotate(cr, 35.0 * M_PI / 180.0);
            cairo_translate(cr, -128.0, -128.0);
            cairo_set_source_surface(cr, cairo_test_surf, 0, 0);
            cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_BILINEAR);
            cairo_paint(cr);
            cairo_restore(cr);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.save();
            b2d_ctx.translate(540.0, 370.0);
            b2d_ctx.rotate(35.0 * M_PI / 180.0);
            b2d_ctx.translate(-128.0, -128.0);
            b2d_ctx.blit_image(BLPointI(0, 0), b2d_test_img);
            b2d_ctx.restore();
#endif
        }
    );

    // 33. Image Pattern Fill (Circle Filled with Texture)
    benchmark_op("33. Image Pattern Fill (Circle Filled with Texture)",
        [&]() {
            Pattern pat(test_pm.as_ref(), SpreadMode::Pad, FilterQuality::Bilinear, 1.0f, Transform::from_translate(412.0f, 242.0f));
            Paint p;
            p.shader = Shader(pat);
            canvas.fill_circle(540.0f, 370.0f, 200.0f, p);
        },
        [&]() {
            cairo_pattern_t* pat = cairo_pattern_create_for_surface(cairo_test_surf);
            cairo_matrix_t m;
            cairo_matrix_init_translate(&m, -412.0, -242.0);
            cairo_pattern_set_matrix(pat, &m);
            cairo_pattern_set_filter(pat, CAIRO_FILTER_BILINEAR);
            cairo_set_source(cr, pat);
            cairo_new_sub_path(cr);
            cairo_arc(cr, 540.0, 370.0, 200.0, 0, 2 * M_PI);
            cairo_fill(cr);
            cairo_pattern_destroy(pat);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            BLPattern pat(b2d_test_img, BL_EXTEND_MODE_PAD, BLMatrix2D::make_translation(412.0, 242.0));
            b2d_ctx.set_fill_style(pat);
            b2d_ctx.fill_circle(540.0, 370.0, 200.0);
#endif
        }
    );

    // 34. Pattern Repeat & Tiling (64x64 Texture Repeat)
    benchmark_op("34. Pattern Repeat & Tiling (64x64 Texture Repeat)",
        [&]() {
            Pattern pat(tile_pm.as_ref(), SpreadMode::Repeat, FilterQuality::Nearest);
            Paint p;
            p.shader = Shader(pat);
            auto r = Rect::from_xywh(140.0f, 120.0f, 800.0f, 500.0f);
            if (r) canvas.fill_rect(*r, p);
        },
        [&]() {
            cairo_pattern_t* pat = cairo_pattern_create_for_surface(cairo_tile_surf);
            cairo_pattern_set_extend(pat, CAIRO_EXTEND_REPEAT);
            cairo_set_source(cr, pat);
            cairo_rectangle(cr, 140.0, 120.0, 800.0, 500.0);
            cairo_fill(cr);
            cairo_pattern_destroy(pat);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_fill_style(BLPattern(b2d_tile_img, BL_EXTEND_MODE_REPEAT));
            b2d_ctx.fill_rect(BLRect(140.0, 120.0, 800.0, 500.0));
#endif
        }
    );

    // Helpers for AA ON vs OFF
    auto run_diagonals_nisaba = [&](bool aa) {
        Paint p(Color::from_rgba8(0, 220, 130, 200));
        p.anti_alias = aa;
        Stroke s(2.0f);
        for (int i = 0; i < 50; ++i) {
            float x0 = static_cast<float>(i * 20);
            float y0 = 0.0f;
            float x1 = static_cast<float>(i * 20 + 200);
            float y1 = static_cast<float>(H);
            canvas.stroke_line(x0, y0, x1, y1, p, s);
        }
    };
    auto run_diagonals_cairo = [&](cairo_antialias_t aa) {
        cairo_set_antialias(cr, aa);
        cairo_set_source_rgba(cr, 0.0, 220.0/255.0, 130.0/255.0, 200.0/255.0);
        cairo_set_line_width(cr, 2.0);
        for (int i = 0; i < 50; ++i) {
            double x0 = i * 20.0;
            double y0 = 0.0;
            double x1 = i * 20.0 + 200.0;
            double y1 = H;
            cairo_move_to(cr, x0, y0);
            cairo_line_to(cr, x1, y1);
        }
        cairo_stroke(cr);
    };

    // 35. Anti-Aliasing ON (50 Diagonals Coverage)
    benchmark_op("35. Anti-Aliasing ON (50 Diagonals Coverage)",
        [&]() { run_diagonals_nisaba(true); },
        [&]() { run_diagonals_cairo(CAIRO_ANTIALIAS_DEFAULT); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_stroke_style(BLRgba32(0, 220, 130, 200));
            b2d_ctx.set_stroke_width(2.0);
            for (int i = 0; i < 50; ++i) {
                b2d_ctx.stroke_line(BLLine(i * 20.0, 0.0, i * 20.0 + 200.0, H));
            }
#endif
        }
    );

    // 36. Anti-Aliasing OFF (50 Diagonals Aliased)
    benchmark_op("36. Anti-Aliasing OFF (50 Diagonals Aliased)",
        [&]() { run_diagonals_nisaba(false); },
        [&]() { run_diagonals_cairo(CAIRO_ANTIALIAS_NONE); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_stroke_style(BLRgba32(0, 220, 130, 200));
            b2d_ctx.set_stroke_width(2.0);
            for (int i = 0; i < 50; ++i) {
                b2d_ctx.stroke_line(BLLine(i * 20.0, 0.0, i * 20.0 + 200.0, H));
            }
#endif
        }
    );

    // Common Zigzag Path for Stroke Join Matrix
    PathBuilder pb_zigzag;
    pb_zigzag.move_to(50.0f, 370.0f);
    for (int i = 0; i < 16; ++i) {
        float x = 50.0f + (i + 1) * 60.0f;
        float y = (i % 2 == 0) ? 250.0f : 490.0f;
        pb_zigzag.line_to(x, y);
    }
    auto zigzag_path_opt = pb_zigzag.finish();
    const Path& zigzag_path = *zigzag_path_opt;

    auto cairo_draw_zigzag = [&]() {
        cairo_new_path(cr);
        cairo_move_to(cr, 50.0, 370.0);
        for (int i = 0; i < 16; ++i) {
            double x = 50.0 + (i + 1) * 60.0;
            double y = (i % 2 == 0) ? 250.0 : 490.0;
            cairo_line_to(cr, x, y);
        }
    };

#ifdef HAVE_BLEND2D
    BLPath b2d_zigzag;
    b2d_zigzag.move_to(50.0, 370.0);
    for (int i = 0; i < 16; ++i) {
        double x = 50.0 + (i + 1) * 60.0;
        double y = (i % 2 == 0) ? 250.0 : 490.0;
        b2d_zigzag.line_to(x, y);
    }
#endif

    // 37. Stroke Join: Miter (Zigzag Polygon 12px)
    benchmark_op("37. Stroke Join: Miter (Zigzag Polygon 12px)",
        [&]() {
            Stroke s(12.0f);
            s.line_join = LineJoin::Miter;
            canvas.stroke_path(zigzag_path, Paint(Color::from_rgba8(244, 63, 94, 220)), s);
        },
        [&]() {
            cairo_draw_zigzag();
            cairo_set_source_rgba(cr, 244/255.0, 63/255.0, 94/255.0, 220/255.0);
            cairo_set_line_width(cr, 12.0);
            cairo_set_line_join(cr, CAIRO_LINE_JOIN_MITER);
            cairo_stroke(cr);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_stroke_style(BLRgba32(244, 63, 94, 220));
            b2d_ctx.set_stroke_width(12.0);
            b2d_ctx.set_stroke_join(BL_STROKE_JOIN_MITER_CLIP);
            b2d_ctx.stroke_path(b2d_zigzag);
#endif
        }
    );

    // 38. Stroke Join: Bevel (Zigzag Polygon 12px)
    benchmark_op("38. Stroke Join: Bevel (Zigzag Polygon 12px)",
