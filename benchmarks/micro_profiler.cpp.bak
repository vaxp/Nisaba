    // 48. State Stack: Save/Restore Overhead (50 Passes)
    benchmark_op("48. State Stack: Save/Restore Overhead (50 Passes)",
        [&]() {
            for (int k = 0; k < 50; ++k) {
                canvas.save();
                canvas.translate(2.0f, 1.0f);
                canvas.scale(0.99f, 0.99f);
            }
            for (int k = 0; k < 50; ++k) {
                canvas.restore();
            }
        },
        [&]() {
            for (int k = 0; k < 50; ++k) {
                cairo_save(cr);
                cairo_translate(cr, 2.0, 1.0);
                cairo_scale(cr, 0.99, 0.99);
            }
            for (int k = 0; k < 50; ++k) {
                cairo_restore(cr);
            }
        },
        [&]() {
#ifdef HAVE_BLEND2D
            for (int k = 0; k < 50; ++k) {
                b2d_ctx.save();
                b2d_ctx.translate(2.0, 1.0);
                b2d_ctx.scale(0.99, 0.99);
            }
            for (int k = 0; k < 50; ++k) {
                b2d_ctx.restore();
            }
#endif
        }
    );

    // 49. Compositing Operator: Multiply (25 Shapes)
    benchmark_op("49. Compositing Operator: Multiply (25 Shapes)",
        [&]() {
            Paint p(Color::from_rgba8(200, 50, 150, 180));
            p.blend_mode = BlendMode::Multiply;
            for (int i = 0; i < 25; ++i) {
                canvas.fill_circle(120.0f + (i % 5) * 190.0f, 120.0f + (i / 5) * 120.0f, 55.0f, p);
            }
        },
        [&]() {
            cairo_set_operator(cr, CAIRO_OPERATOR_MULTIPLY);
            cairo_set_source_rgba(cr, 200/255.0, 50/255.0, 150/255.0, 180/255.0);
            for (int i = 0; i < 25; ++i) {
                cairo_new_sub_path(cr);
                cairo_arc(cr, 120.0 + (i % 5) * 190.0, 120.0 + (i / 5) * 120.0, 55.0, 0, 2*M_PI);
                cairo_fill(cr);
            }
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_comp_op(BL_COMP_OP_MULTIPLY);
            b2d_ctx.set_fill_style(BLRgba32(200, 50, 150, 180));
            for (int i = 0; i < 25; ++i) {
                b2d_ctx.fill_circle(120.0 + (i % 5) * 190.0, 120.0 + (i / 5) * 120.0, 55.0);
            }
#endif
        }
    );

    // 50. Compositing Operator: Screen (25 Shapes)
    benchmark_op("50. Compositing Operator: Screen (25 Shapes)",
        [&]() {
            Paint p(Color::from_rgba8(50, 200, 150, 180));
            p.blend_mode = BlendMode::Screen;
            for (int i = 0; i < 25; ++i) {
                canvas.fill_circle(120.0f + (i % 5) * 190.0f, 120.0f + (i / 5) * 120.0f, 55.0f, p);
            }
        },
        [&]() {
            cairo_set_operator(cr, CAIRO_OPERATOR_SCREEN);
            cairo_set_source_rgba(cr, 50/255.0, 200/255.0, 150/255.0, 180/255.0);
            for (int i = 0; i < 25; ++i) {
                cairo_new_sub_path(cr);
                cairo_arc(cr, 120.0 + (i % 5) * 190.0, 120.0 + (i / 5) * 120.0, 55.0, 0, 2*M_PI);
                cairo_fill(cr);
            }
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_comp_op(BL_COMP_OP_SCREEN);
            b2d_ctx.set_fill_style(BLRgba32(50, 200, 150, 180));
            for (int i = 0; i < 25; ++i) {
                b2d_ctx.fill_circle(120.0 + (i % 5) * 190.0, 120.0 + (i / 5) * 120.0, 55.0);
            }
#endif
        }
    );

    // 51. Compositing Operator: Source-In & Xor (25 Shapes)
    benchmark_op("51. Compositing Operator: Source-In & Xor (25 Shapes)",
        [&]() {
            Paint p(Color::from_rgba8(250, 204, 21, 180));
            for (int i = 0; i < 25; ++i) {
                p.blend_mode = (i % 2 == 0) ? BlendMode::SourceIn : BlendMode::Xor;
                canvas.fill_circle(120.0f + (i % 5) * 190.0f, 120.0f + (i / 5) * 120.0f, 55.0f, p);
            }
        },
        [&]() {
            cairo_set_source_rgba(cr, 250/255.0, 204/255.0, 21/255.0, 180/255.0);
            for (int i = 0; i < 25; ++i) {
                cairo_set_operator(cr, (i % 2 == 0) ? CAIRO_OPERATOR_IN : CAIRO_OPERATOR_XOR);
                cairo_new_sub_path(cr);
                cairo_arc(cr, 120.0 + (i % 5) * 190.0, 120.0 + (i / 5) * 120.0, 55.0, 0, 2*M_PI);
                cairo_fill(cr);
            }
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_fill_style(BLRgba32(250, 204, 21, 180));
            for (int i = 0; i < 25; ++i) {
                b2d_ctx.set_comp_op((i % 2 == 0) ? BL_COMP_OP_SRC_IN : BL_COMP_OP_XOR);
                b2d_ctx.fill_circle(120.0 + (i % 5) * 190.0, 120.0 + (i / 5) * 120.0, 55.0);
            }
#endif
        }
    );

    // Helpers for Path Complexity Scaling (Waveforms)
    auto make_waveform = [](int count) {
        PathBuilder pb;
        pb.move_to(40.0f, 370.0f);
        for (int i = 1; i < count; ++i) {
            float x = 40.0f + (static_cast<float>(i) / (count - 1)) * 1000.0f;
            float y = 370.0f + 180.0f * std::sin(static_cast<float>(i) * 0.15f);
            pb.line_to(x, y);
        }
        return pb.finish();
    };

    auto cairo_waveform = [](cairo_t* cr, int count) {
        cairo_new_path(cr);
        cairo_move_to(cr, 40.0, 370.0);
        for (int i = 1; i < count; ++i) {
            double x = 40.0 + (static_cast<double>(i) / (count - 1)) * 1000.0;
            double y = 370.0 + 180.0 * std::sin(i * 0.15);
            cairo_line_to(cr, x, y);
        }
        cairo_stroke(cr);
    };

    auto wave10_opt = make_waveform(10);
    auto wave100_opt = make_waveform(100);
    auto wave1000_opt = make_waveform(1000);
    const Path& wave10 = *wave10_opt;
    const Path& wave100 = *wave100_opt;
    const Path& wave1000 = *wave1000_opt;
    Paint wave_paint(Color::from_rgba8(56, 189, 248, 220));
    Stroke wave_stroke(2.5f);

    // 52. Path Complexity: Low (10 Vertices Waveform)
    benchmark_op("52. Path Complexity: Low (10 Vertices Waveform)",
        [&]() { canvas.stroke_path(wave10, wave_paint, wave_stroke); },
        [&]() {
            cairo_set_source_rgba(cr, 56/255.0, 189/255.0, 248/255.0, 220/255.0);
            cairo_set_line_width(cr, 2.5);
            cairo_waveform(cr, 10);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_stroke_style(BLRgba32(56, 189, 248, 220));
            b2d_ctx.set_stroke_width(2.5);
            BLPath p;
            p.move_to(40.0, 370.0);
            for (int i = 1; i < 10; ++i) {
                p.line_to(40.0 + (i / 9.0) * 1000.0, 370.0 + 180.0 * std::sin(i * 0.15));
            }
            b2d_ctx.stroke_path(p);
#endif
        }
    );

    // 53. Path Complexity: Medium (100 Vertices Waveform)
    benchmark_op("53. Path Complexity: Medium (100 Vertices Waveform)",
        [&]() { canvas.stroke_path(wave100, wave_paint, wave_stroke); },
        [&]() {
            cairo_set_source_rgba(cr, 56/255.0, 189/255.0, 248/255.0, 220/255.0);
            cairo_set_line_width(cr, 2.5);
            cairo_waveform(cr, 100);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_stroke_style(BLRgba32(56, 189, 248, 220));
            b2d_ctx.set_stroke_width(2.5);
            BLPath p;
            p.move_to(40.0, 370.0);
            for (int i = 1; i < 100; ++i) {
                p.line_to(40.0 + (i / 99.0) * 1000.0, 370.0 + 180.0 * std::sin(i * 0.15));
            }
            b2d_ctx.stroke_path(p);
#endif
        }
    );

    // 54. Path Complexity: High (1000 Vertices Waveform)
    benchmark_op("54. Path Complexity: High (1000 Vertices Waveform)",
        [&]() { canvas.stroke_path(wave1000, wave_paint, wave_stroke); },
        [&]() {
            cairo_set_source_rgba(cr, 56/255.0, 189/255.0, 248/255.0, 220/255.0);
            cairo_set_line_width(cr, 2.5);
            cairo_waveform(cr, 1000);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_stroke_style(BLRgba32(56, 189, 248, 220));
            b2d_ctx.set_stroke_width(2.5);
            BLPath p;
            p.move_to(40.0, 370.0);
            for (int i = 1; i < 1000; ++i) {
                p.line_to(40.0 + (i / 999.0) * 1000.0, 370.0 + 180.0 * std::sin(i * 0.15));
            }
            b2d_ctx.stroke_path(p);
#endif
        }
    );

    // Helpers for Primitive-Count Scaling
    auto draw_rects_nisaba = [&](int count) {
        Paint p(Color::from_rgba8(99, 102, 241, 150));
        for (int i = 0; i < count; ++i) {
            float x = static_cast<float>((i * 73) % (W - 40));
            float y = static_cast<float>((i * 59) % (H - 40));
            auto r = Rect::from_xywh(x, y, 35.0f, 35.0f);
            if (r) canvas.fill_rect(*r, p);
        }
    };
    auto draw_rects_cairo = [&](int count) {
        cairo_set_source_rgba(cr, 99/255.0, 102/255.0, 241/255.0, 150/255.0);
        for (int i = 0; i < count; ++i) {
            double x = (i * 73) % (W - 40);
            double y = (i * 59) % (H - 40);
            cairo_rectangle(cr, x, y, 35.0, 35.0);
            cairo_fill(cr);
        }
    };

    // 55. Primitive Scaling: 100 Rectangles Batch
    benchmark_op("55. Primitive Scaling: 100 Rectangles Batch",
        [&]() { draw_rects_nisaba(100); },
        [&]() { draw_rects_cairo(100); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_fill_style(BLRgba32(99, 102, 241, 150));
            for (int i = 0; i < 100; ++i) {
                b2d_ctx.fill_rect(BLRect((i * 73) % (W - 40), (i * 59) % (H - 40), 35.0, 35.0));
            }
#endif
        }
    );

    // 56. Primitive Scaling: 500 Rectangles Batch
    benchmark_op("56. Primitive Scaling: 500 Rectangles Batch",
        [&]() { draw_rects_nisaba(500); },
        [&]() { draw_rects_cairo(500); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_fill_style(BLRgba32(99, 102, 241, 150));
            for (int i = 0; i < 500; ++i) {
                b2d_ctx.fill_rect(BLRect((i * 73) % (W - 40), (i * 59) % (H - 40), 35.0, 35.0));
            }
#endif
        }
    );

    // 57. Primitive Scaling: 1000 Rectangles Batch
    benchmark_op("57. Primitive Scaling: 1000 Rectangles Batch",
        [&]() { draw_rects_nisaba(1000); },
        [&]() { draw_rects_cairo(1000); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_fill_style(BLRgba32(99, 102, 241, 150));
            for (int i = 0; i < 1000; ++i) {
                b2d_ctx.fill_rect(BLRect((i * 73) % (W - 40), (i * 59) % (H - 40), 35.0, 35.0));
            }
#endif
        }
    );

    // Helpers for Clip-Depth Scaling (Drawing 50 grid lines inside nested clips)
    auto draw_clip_content_nisaba = [&]() {
        Paint p(Color::from_rgba8(245, 158, 11, 220));
        Stroke s(2.0f);
        for (int i = 0; i < 50; ++i) {
            float x = static_cast<float>(i * 20);
            canvas.stroke_line(x, 0.0f, x, static_cast<float>(H), p, s);
        }
    };
    auto draw_clip_content_cairo = [&]() {
        cairo_set_source_rgba(cr, 245/255.0, 158/255.0, 11/255.0, 220/255.0);
        cairo_set_line_width(cr, 2.0);
        for (int i = 0; i < 50; ++i) {
            double x = i * 20.0;
            cairo_move_to(cr, x, 0.0);
            cairo_line_to(cr, x, H);
        }
        cairo_stroke(cr);
    };

    // 58. Clip-Depth Scaling: 1-Level Vector Clip
    benchmark_op("58. Clip-Depth Scaling: 1-Level Vector Clip",
        [&]() {
            canvas.save();
            auto c1 = PathBuilder::from_circle(540.0f, 370.0f, 320.0f);
            if (c1) canvas.clip_path(*c1);
            draw_clip_content_nisaba();
            canvas.restore();
        },
        [&]() {
            cairo_save(cr);
            cairo_new_sub_path(cr);
            cairo_arc(cr, 540.0, 370.0, 320.0, 0, 2*M_PI);
            cairo_clip(cr);
            draw_clip_content_cairo();
            cairo_restore(cr);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.save();
            b2d_ctx.clip_to_rect(BLRect(540.0 - 320.0, 370.0 - 320.0, 640.0, 640.0));
            b2d_ctx.set_stroke_style(BLRgba32(245, 158, 11, 220));
            b2d_ctx.set_stroke_width(2.0);
            for (int i = 0; i < 50; ++i) {
                b2d_ctx.stroke_line(BLLine(i * 20.0, 0.0, i * 20.0, H));
            }
            b2d_ctx.restore();
#endif
        }
    );

    // 59. Clip-Depth Scaling: 2-Level Nested Vector Clip
    benchmark_op("59. Clip-Depth Scaling: 2-Level Nested Vector Clip",
        [&]() {
            canvas.save();
            auto c1 = PathBuilder::from_circle(540.0f, 370.0f, 320.0f);
            if (c1) canvas.clip_path(*c1);
            auto c2 = PathBuilder::from_rect(*Rect::from_xywh(200.0f, 150.0f, 680.0f, 440.0f));
            canvas.clip_path(c2);
            draw_clip_content_nisaba();
            canvas.restore();
        },
        [&]() {
            cairo_save(cr);
            cairo_new_sub_path(cr);
            cairo_arc(cr, 540.0, 370.0, 320.0, 0, 2*M_PI);
            cairo_clip(cr);
            cairo_rectangle(cr, 200.0, 150.0, 680.0, 440.0);
            cairo_clip(cr);
            draw_clip_content_cairo();
            cairo_restore(cr);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.save();
            b2d_ctx.clip_to_rect(BLRect(540.0 - 320.0, 370.0 - 320.0, 640.0, 640.0));
            b2d_ctx.clip_to_rect(BLRect(200.0, 150.0, 680.0, 440.0));
            b2d_ctx.set_stroke_style(BLRgba32(245, 158, 11, 220));
            b2d_ctx.set_stroke_width(2.0);
            for (int i = 0; i < 50; ++i) {
                b2d_ctx.stroke_line(BLLine(i * 20.0, 0.0, i * 20.0, H));
            }
            b2d_ctx.restore();
#endif
        }
    );

    // 60. Clip-Depth Scaling: 4-Level Nested Vector Clip
    benchmark_op("60. Clip-Depth Scaling: 4-Level Nested Vector Clip",
        [&]() {
            canvas.save();
            auto c1 = PathBuilder::from_circle(540.0f, 370.0f, 320.0f);
            if (c1) canvas.clip_path(*c1);
            auto c2 = PathBuilder::from_rect(*Rect::from_xywh(200.0f, 150.0f, 680.0f, 440.0f));
            canvas.clip_path(c2);
            auto c3 = PathBuilder::from_circle(440.0f, 320.0f, 250.0f);
            if (c3) canvas.clip_path(*c3);
            auto c4 = PathBuilder::from_circle(640.0f, 420.0f, 250.0f);
            if (c4) canvas.clip_path(*c4);
            draw_clip_content_nisaba();
            canvas.restore();
        },
        [&]() {
            cairo_save(cr);
            cairo_new_sub_path(cr);
            cairo_arc(cr, 540.0, 370.0, 320.0, 0, 2*M_PI);
            cairo_clip(cr);
            cairo_rectangle(cr, 200.0, 150.0, 680.0, 440.0);
            cairo_clip(cr);
            cairo_new_sub_path(cr);
            cairo_arc(cr, 440.0, 320.0, 250.0, 0, 2*M_PI);
            cairo_clip(cr);
            cairo_new_sub_path(cr);
            cairo_arc(cr, 640.0, 420.0, 250.0, 0, 2*M_PI);
            cairo_clip(cr);
            draw_clip_content_cairo();
            cairo_restore(cr);
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.save();
            b2d_ctx.clip_to_rect(BLRect(540.0 - 320.0, 370.0 - 320.0, 640.0, 640.0));
            b2d_ctx.clip_to_rect(BLRect(200.0, 150.0, 680.0, 440.0));
            b2d_ctx.clip_to_rect(BLRect(440.0 - 250.0, 320.0 - 250.0, 500.0, 500.0));
            b2d_ctx.clip_to_rect(BLRect(640.0 - 250.0, 420.0 - 250.0, 500.0, 500.0));
            b2d_ctx.set_stroke_style(BLRgba32(245, 158, 11, 220));
            b2d_ctx.set_stroke_width(2.0);
            for (int i = 0; i < 50; ++i) {
                b2d_ctx.stroke_line(BLLine(i * 20.0, 0.0, i * 20.0, H));
            }
            b2d_ctx.restore();
#endif
        }
    );

    // Helpers for Resolution Scaling
    auto run_resolution_scene_nisaba = [&](uint32_t vp_w, uint32_t vp_h) {
        auto clip_r = ScreenIntRect::from_xywh(0, 0, vp_w, vp_h);
        if (clip_r) canvas.set_scissor_clip(*clip_r);
        canvas.clear(Color::from_rgba8(15, 23, 42, 255));
        std::vector<GradientStop> stops = {
            GradientStop::create(0.0f, Color::from_rgba8(59, 130, 246, 200)),
            GradientStop::create(1.0f, Color::from_rgba8(236, 72, 153, 200))
        };
        auto lin = LinearGradient::create(Point::from_xy(0, 0), Point::from_xy(static_cast<float>(vp_w), static_cast<float>(vp_h)), stops);
        if (lin) {
            auto r = Rect::from_xywh(0, 0, static_cast<float>(vp_w), static_cast<float>(vp_h));
            if (r) canvas.fill_rect(*r, Paint(Shader(std::move(*lin))));
        }
        for (int i = 0; i < 15; ++i) {
            float cx = static_cast<float>((i * 67) % vp_w);
            float cy = static_cast<float>((i * 53) % vp_h);
            canvas.fill_circle(cx, cy, 25.0f, Paint(Color::from_rgba8(255, 255, 255, 80)));
        }
        canvas.set_scissor_clip(std::nullopt);
    };

    auto run_resolution_scene_cairo = [&](uint32_t vp_w, uint32_t vp_h) {
        cairo_save(cr);
        cairo_rectangle(cr, 0, 0, vp_w, vp_h);
        cairo_clip(cr);
        cairo_set_source_rgb(cr, 15/255.0, 23/255.0, 42/255.0);
        cairo_paint(cr);
        cairo_pattern_t* lin = cairo_pattern_create_linear(0, 0, vp_w, vp_h);
        cairo_pattern_add_color_stop_rgba(lin, 0.0, 59/255.0, 130/255.0, 246/255.0, 200/255.0);
        cairo_pattern_add_color_stop_rgba(lin, 1.0, 236/255.0, 72/255.0, 153/255.0, 200/255.0);
        cairo_set_source(cr, lin);
        cairo_paint(cr);
        cairo_pattern_destroy(lin);
        cairo_set_source_rgba(cr, 1.0, 1.0, 1.0, 80/255.0);
        for (int i = 0; i < 15; ++i) {
            double cx = (i * 67) % vp_w;
            double cy = (i * 53) % vp_h;
            cairo_new_sub_path(cr);
            cairo_arc(cr, cx, cy, 25.0, 0, 2*M_PI);
            cairo_fill(cr);
        }
        cairo_restore(cr);
    };

    // 61. Resolution Scaling: Small (256x256 Viewport)
    benchmark_op("61. Resolution Scaling: Small (256x256 Viewport)",
        [&]() { run_resolution_scene_nisaba(256, 256); },
        [&]() { run_resolution_scene_cairo(256, 256); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.save();
            b2d_ctx.clip_to_rect(BLRect(0, 0, 256, 256));
            b2d_ctx.set_fill_style(BLRgba32(15, 23, 42, 255));
            b2d_ctx.fill_all();
            BLLinearGradientValues g_val{0.0, 0.0, 256.0, 256.0};
            BLGradient g(g_val);
            g.add_stop(0.0, BLRgba32(59, 130, 246, 200));
            g.add_stop(1.0, BLRgba32(236, 72, 153, 200));
            b2d_ctx.set_fill_style(g);
            b2d_ctx.fill_all();
            b2d_ctx.set_fill_style(BLRgba32(255, 255, 255, 80));
            for (int i = 0; i < 15; ++i) {
                b2d_ctx.fill_circle((i * 67) % 256, (i * 53) % 256, 25.0);
            }
            b2d_ctx.restore();
#endif
        }
    );

    // 62. Resolution Scaling: Medium (640x480 Viewport)
    benchmark_op("62. Resolution Scaling: Medium (640x480 Viewport)",
        [&]() { run_resolution_scene_nisaba(640, 480); },
        [&]() { run_resolution_scene_cairo(640, 480); },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.save();
            b2d_ctx.clip_to_rect(BLRect(0, 0, 640, 480));
            b2d_ctx.set_fill_style(BLRgba32(15, 23, 42, 255));
            b2d_ctx.fill_all();
            BLLinearGradientValues g_val{0.0, 0.0, 640.0, 480.0};
            BLGradient g(g_val);
            g.add_stop(0.0, BLRgba32(59, 130, 246, 200));
            g.add_stop(1.0, BLRgba32(236, 72, 153, 200));
            b2d_ctx.set_fill_style(g);
            b2d_ctx.fill_all();
            b2d_ctx.set_fill_style(BLRgba32(255, 255, 255, 80));
            for (int i = 0; i < 15; ++i) {
                b2d_ctx.fill_circle((i * 67) % 640, (i * 53) % 480, 25.0);
            }
            b2d_ctx.restore();
#endif
        }
    );

    // 63. Resolution Scaling: Full Viewport (1080x740)
    benchmark_op("63. Resolution Scaling: Full Viewport (1080x740)",
        [&]() { run_resolution_scene_nisaba(1080, 740); },
        [&]() { run_resolution_scene_cairo(1080, 740); },
        [&]() {
