            for (int i = 0; i < 50; ++i) {
                float tx = 100.0f + (i % 10) * 95.0f;
                float ty = 100.0f + (i / 10) * 120.0f;
                float angle_deg = i * 7.2f;

                canvas.save();
                canvas.translate(tx, ty);
                canvas.rotate(angle_deg);
                if (r_opt) canvas.fill_rect(*r_opt, p);
                canvas.restore();
            }
        },
        [&]() {
            for (int i = 0; i < 50; ++i) {
                double tx = 100.0 + (i % 10) * 95.0;
                double ty = 100.0 + (i / 10) * 120.0;
                double angle_rad = (i * 7.2) * (M_PI / 180.0);

                cairo_save(cr);
                cairo_translate(cr, tx, ty);
                cairo_rotate(cr, angle_rad);
                cairo_rectangle(cr, -60, -40, 120, 80);
                cairo_set_source_rgba(cr, 99/255.0, 102/255.0, 241/255.0, 140/255.0);
                cairo_fill(cr);
                cairo_restore(cr);
            }
        },
        [&]() {
#ifdef HAVE_BLEND2D
            for (int i = 0; i < 50; ++i) {
                double tx = 100.0 + (i % 10) * 95.0;
                double ty = 100.0 + (i / 10) * 120.0;
                double angle_rad = (i * 7.2) * (M_PI / 180.0);

                b2d_ctx.save();
                b2d_ctx.translate(tx, ty);
                b2d_ctx.rotate(angle_rad);
