    // Base Rect for Transform Isolation Benchmarks
    auto base_rect_opt = Rect::from_xywh(0.0f, 0.0f, 100.0f, 70.0f);
    const Rect& base_rect = *base_rect_opt;
    Paint transform_p(Color::from_rgba8(168, 85, 247, 180));

    // 43. Transform Isolation: Pure Translate (20 Shapes)
    benchmark_op("43. Transform Isolation: Pure Translate (20 Shapes)",
        [&]() {
            for (int i = 0; i < 20; ++i) {
                canvas.save();
                canvas.translate(80.0f + (i % 5) * 190.0f, 80.0f + (i / 5) * 150.0f);
                canvas.fill_round_rect(base_rect, 10.0f, 10.0f, transform_p);
                canvas.restore();
            }
        },
        [&]() {
            cairo_set_source_rgba(cr, 168/255.0, 85/255.0, 247/255.0, 180/255.0);
            for (int i = 0; i < 20; ++i) {
                cairo_save(cr);
                cairo_translate(cr, 80.0 + (i % 5) * 190.0, 80.0 + (i / 5) * 150.0);
                cairo_round_rect(cr, 0.0, 0.0, 100.0, 70.0, 10.0, 10.0);
                cairo_fill(cr);
                cairo_restore(cr);
            }
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_fill_style(BLRgba32(168, 85, 247, 180));
            for (int i = 0; i < 20; ++i) {
                b2d_ctx.save();
                b2d_ctx.translate(80.0 + (i % 5) * 190.0, 80.0 + (i / 5) * 150.0);
                b2d_ctx.fill_round_rect(BLRoundRect(0.0, 0.0, 100.0, 70.0, 10.0, 10.0));
                b2d_ctx.restore();
            }
#endif
        }
    );

    // 44. Transform Isolation: Pure Scale (20 Shapes)
    benchmark_op("44. Transform Isolation: Pure Scale (20 Shapes)",
        [&]() {
            for (int i = 0; i < 20; ++i) {
                canvas.save();
                canvas.translate(80.0f + (i % 5) * 190.0f, 80.0f + (i / 5) * 150.0f);
                float s = 0.5f + (i % 5) * 0.15f;
                canvas.scale(s, s);
                canvas.fill_round_rect(base_rect, 10.0f, 10.0f, transform_p);
                canvas.restore();
            }
        },
        [&]() {
            cairo_set_source_rgba(cr, 168/255.0, 85/255.0, 247/255.0, 180/255.0);
            for (int i = 0; i < 20; ++i) {
                cairo_save(cr);
                cairo_translate(cr, 80.0 + (i % 5) * 190.0, 80.0 + (i / 5) * 150.0);
                double s = 0.5 + (i % 5) * 0.15;
                cairo_scale(cr, s, s);
                cairo_round_rect(cr, 0.0, 0.0, 100.0, 70.0, 10.0, 10.0);
                cairo_fill(cr);
                cairo_restore(cr);
            }
        },
        [&]() {
#ifdef HAVE_BLEND2D
            b2d_ctx.set_fill_style(BLRgba32(168, 85, 247, 180));
            for (int i = 0; i < 20; ++i) {
                b2d_ctx.save();
                b2d_ctx.translate(80.0 + (i % 5) * 190.0, 80.0 + (i / 5) * 150.0);
                double s = 0.5 + (i % 5) * 0.15;
                b2d_ctx.scale(s, s);
                b2d_ctx.fill_round_rect(BLRoundRect(0.0, 0.0, 100.0, 70.0, 10.0, 10.0));
                b2d_ctx.restore();
            }
#endif
        }
    );

    // 45. Transform Isolation: Pure Rotate (20 Shapes)
    benchmark_op("45. Transform Isolation: Pure Rotate (20 Shapes)",
        [&]() {
            for (int i = 0; i < 20; ++i) {
                canvas.save();
