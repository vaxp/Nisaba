    );

    // Print Detailed 3-Way Comparative Report
    std::cout << std::left << std::setw(56) << "Operation Name"
              << std::right << std::setw(14) << "Nisaba (µs)"
              << std::setw(14) << "Cairo (µs)"
              << std::setw(15) << "Blend2D (µs)"
              << std::setw(20) << "vs Cairo"
              << std::setw(22) << "vs Blend2D" << "\n";
    std::cout << "--------------------------------------------------------------------------------------------------------------------------------------\n";

    double total_nisaba = 0;
    double total_cairo = 0;
    double total_b2d = 0;

    for (const auto& s : stats) {
        total_nisaba += s.nisaba_us;
        total_cairo += s.cairo_us;
        total_b2d += s.b2d_us;

        // Ratio vs Cairo
        std::string verdict_cairo;
        double r_c = (s.nisaba_us > 0) ? (s.cairo_us / s.nisaba_us) : 1.0;
        if (r_c > 1.05) {
            std::ostringstream ss;
            ss << std::fixed << std::setprecision(2) << r_c << "x (Nisaba)";
            verdict_cairo = ss.str();
        } else if (r_c < 0.95) {
            std::ostringstream ss;
            ss << std::fixed << std::setprecision(2) << (1.0 / r_c) << "x (Cairo)";
            verdict_cairo = ss.str();
        } else {
            verdict_cairo = "Tie (~1.0x)";
        }

        // Ratio vs Blend2D
        std::string verdict_b2d;
        if (s.b2d_us <= 0.0) {
            verdict_b2d = "N/A (Disabled)";
        } else {
            double r_b = (s.nisaba_us > 0) ? (s.b2d_us / s.nisaba_us) : 1.0;
            if (r_b > 1.05) {
                std::ostringstream ss;
                ss << std::fixed << std::setprecision(2) << r_b << "x (Nisaba)";
                verdict_b2d = ss.str();
            } else if (r_b < 0.95) {
                std::ostringstream ss;
                ss << std::fixed << std::setprecision(2) << (1.0 / r_b) << "x (Blend2D)";
                verdict_b2d = ss.str();
            } else {
                verdict_b2d = "Tie (~1.0x)";
            }
        }

        std::ostringstream s_nisaba, s_cairo, s_b2d;
        s_nisaba << std::fixed << std::setprecision(1) << s.nisaba_us << " µs";
        s_cairo << std::fixed << std::setprecision(1) << s.cairo_us << " µs";
        if (s.b2d_us <= 0.0) {
            s_b2d << "N/A";
        } else {
            s_b2d << std::fixed << std::setprecision(1) << s.b2d_us << " µs";
        }

        std::cout << std::left << std::setw(56) << s.name
                  << std::right << std::setw(14) << s_nisaba.str()
                  << std::setw(14) << s_cairo.str()
                  << std::setw(15) << s_b2d.str()
                  << std::setw(20) << verdict_cairo
                  << std::setw(22) << verdict_b2d << "\n";
    }

    std::cout << "--------------------------------------------------------------------------------------------------------------------------------------\n";
    std::ostringstream s_tot_n, s_tot_c, s_tot_b;
    s_tot_n << std::fixed << std::setprecision(1) << total_nisaba << " µs";
    s_tot_c << std::fixed << std::setprecision(1) << total_cairo << " µs";
    if (total_b2d <= 0.0) {
        s_tot_b << "N/A";
    } else {
        s_tot_b << std::fixed << std::setprecision(1) << total_b2d << " µs";
    }

    std::cout << std::left << std::setw(56) << "TOTAL FRAME OVERHEAD"
              << std::right << std::setw(14) << s_tot_n.str()
              << std::setw(14) << s_tot_c.str()
              << std::setw(15) << s_tot_b.str();

    double total_r_c = total_cairo / total_nisaba;
    std::ostringstream ss_tc, ss_tb;
    if (total_r_c >= 1.0) ss_tc << std::fixed << std::setprecision(2) << total_r_c << "x (Nisaba)";
    else ss_tc << std::fixed << std::setprecision(2) << (1.0/total_r_c) << "x (Cairo)";

    if (total_b2d <= 0.0) {
        ss_tb << "N/A";
    } else {
        double total_r_b = total_b2d / total_nisaba;
        if (total_r_b >= 1.0) ss_tb << std::fixed << std::setprecision(2) << total_r_b << "x (Nisaba)";
        else ss_tb << std::fixed << std::setprecision(2) << (1.0/total_r_b) << "x (Blend2D)";
    }

    std::cout << std::setw(20) << ss_tc.str()
              << std::setw(22) << ss_tb.str() << "\n";

    std::cout << "======================================================================================================================================\n\n";

    // Win / Loss Scorecard Summary
    int nisaba_wins_cairo = 0;
    int cairo_wins_nisaba = 0;
    int ties_cairo = 0;

    int nisaba_wins_b2d = 0;
    int b2d_wins_nisaba = 0;
    int ties_b2d = 0;
    bool b2d_tested = false;

    for (const auto& s : stats) {
        if (s.nisaba_us < s.cairo_us) {
            nisaba_wins_cairo++;
        } else if (s.cairo_us < s.nisaba_us) {
            cairo_wins_nisaba++;
        } else {
            ties_cairo++;
        }

        if (s.b2d_us > 0.0) {
            b2d_tested = true;
            if (s.nisaba_us < s.b2d_us) {
                nisaba_wins_b2d++;
            } else if (s.b2d_us < s.nisaba_us) {
                b2d_wins_nisaba++;
            } else {
                ties_b2d++;
            }
        }
    }

    double pct_n_c = (double)nisaba_wins_cairo / stats.size() * 100.0;
    double pct_c_n = (double)cairo_wins_nisaba / stats.size() * 100.0;

    std::cout << "======================================================================================================================================\n";
    std::cout << "                                                  WIN / LOSS BENCHMARK SCORECARD                                                      \n";
    std::cout << "======================================================================================================================================\n";
    std::cout << "  Total Benchmark Suites: " << stats.size() << "\n\n";
    std::cout << "  [Nisaba vs GNU Cairo 1.18]\n";
    std::cout << "    * Nisaba Won: " << nisaba_wins_cairo << " / " << stats.size() << " tests (" << std::fixed << std::setprecision(1) << pct_n_c << "%)\n";
    std::cout << "    * Cairo Won:  " << cairo_wins_nisaba << " / " << stats.size() << " tests (" << std::fixed << std::setprecision(1) << pct_c_n << "%)\n";
    if (ties_cairo > 0) {
        std::cout << "    * Ties:       " << ties_cairo << " / " << stats.size() << " tests\n";
    }

    if (b2d_tested) {
        double pct_n_b = (double)nisaba_wins_b2d / stats.size() * 100.0;
        double pct_b_n = (double)b2d_wins_nisaba / stats.size() * 100.0;
        std::cout << "\n  [Nisaba vs Blend2D (JIT)]\n";
        std::cout << "    * Nisaba Won:  " << nisaba_wins_b2d << " / " << stats.size() << " tests (" << std::fixed << std::setprecision(1) << pct_n_b << "%)\n";
        std::cout << "    * Blend2D Won: " << b2d_wins_nisaba << " / " << stats.size() << " tests (" << std::fixed << std::setprecision(1) << pct_b_n << "%)\n";
        if (ties_b2d > 0) {
            std::cout << "    * Ties:        " << ties_b2d << " / " << stats.size() << " tests\n";
        }
    } else {
        std::cout << "\n  [Blend2D (JIT)]: N/A (Disabled in current build configuration)\n";
    }
    std::cout << "======================================================================================================================================\n\n";

#ifdef HAVE_BLEND2D
    b2d_ctx.end();
#endif
    cairo_destroy(cr);
    cairo_surface_destroy(cairo_surf);
    cairo_surface_destroy(cairo_test_surf);
    cairo_surface_destroy(cairo_tile_surf);
    return 0;
}
