                float r = i * 11.0f;
                uint8_t red_val = (i % 2 == 0) ? 239 : 59;
                uint8_t green_val = (i % 2 == 0) ? 68 : 130;
                uint8_t blue_val = (i % 2 == 0) ? 68 : 246;
                canvas.stroke_circle(W * 0.5f, H * 0.5f, r, Paint(Color::from_rgba8(red_val, green_val, blue_val, 210)), s);
            }
        },
        [&]() {
            cairo_set_line_width(cr, 6.0);
            for (int i = 1; i <= 25; ++i) {
                double r = i * 11.0;
                double red_val = (i % 2 == 0) ? 239/255.0 : 59/255.0;
                double green_val = (i % 2 == 0) ? 68/255.0 : 130/255.0;
                double blue_val = (i % 2 == 0) ? 68/255.0 : 246/255.0;
                cairo_new_sub_path(cr);
                cairo_arc(cr, W * 0.5, H * 0.5, r, 0, 2 * M_PI);
                cairo_set_source_rgba(cr, red_val, green_val, blue_val, 210/255.0);
