    );

    // 46. Transform Isolation: Pure Shear (20 Shapes)
    benchmark_op("46. Transform Isolation: Pure Shear (20 Shapes)",
        [&]() {
            for (int i = 0; i < 20; ++i) {
                canvas.save();
                canvas.translate(80.0f + (i % 5) * 190.0f, 80.0f + (i / 5) * 150.0f);
                canvas.concat(Transform::from_skew(0.25f, 0.15f));
